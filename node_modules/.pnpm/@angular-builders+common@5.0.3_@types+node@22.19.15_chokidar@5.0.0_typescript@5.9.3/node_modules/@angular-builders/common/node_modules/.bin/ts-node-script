#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../../../../../ts-node@10.9.2_@types+node@22.19.15_typescript@5.9.3/node_modules/ts-node/dist/bin-script.js" "$@"
else
  exec node  "$basedir/../../../../../../ts-node@10.9.2_@types+node@22.19.15_typescript@5.9.3/node_modules/ts-node/dist/bin-script.js" "$@"
fi
